{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "madhavswork.vercel.app"
        }
      ],
      "destination": "https://www.madhavjolly.site/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "madhavswork.vercel.app"
        }
      ],
      "destination": "https://www.madhavjolly.site/:path*",
      "permanent": true
    },
    {
      "source": "/assets/Madhav-Jolly-Resume-2026.pdf",
      "destination": "/assets/Madhav-Jolly-Resume-2027.pdf",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/portfolio_final_3_2026.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}